import json
import os
from typing import Any, Dict, List

import requests
from django.contrib.auth.decorators import login_required
from django.http import JsonResponse
from django.shortcuts import render
from django.views.decorators.http import require_POST


LAND_GROUP_NAME = os.getenv("LAND_GROUP_NAME", "land_user")

QDRANT_URL = os.getenv("LAND_QDRANT_URL", "http://192.168.1.176:31633").rstrip("/")
COLLECTION_NAME = os.getenv("LAND_COLLECTION_NAME", "bhumipedia_land_laws")

OLLAMA_URL = os.getenv("LAND_OLLAMA_URL", "http://192.168.1.144:31134").rstrip("/")
EMBED_MODEL = os.getenv("LAND_EMBED_MODEL", "nomic-embed-text")
LLM_MODEL = os.getenv("LAND_LLM_MODEL", "aya-expanse:8b")

TOP_K = int(os.getenv("LAND_TOP_K", "6"))


def land_has_access(user) -> bool:
    if not user.is_authenticated:
        return False
    if user.is_superuser:
        return True
    return user.groups.filter(name=LAND_GROUP_NAME).exists()


def json_error(message: str, status: int = 400):
    return JsonResponse(
        {"ok": False, "error": message},
        status=status,
        json_dumps_params={"ensure_ascii": False},
    )


def embed_text(text: str) -> List[float]:
    try:
        r = requests.post(
            f"{OLLAMA_URL}/api/embed",
            json={"model": EMBED_MODEL, "input": [text]},
            timeout=120,
        )
        if r.status_code == 200:
            data = r.json()
            embs = data.get("embeddings")
            if embs:
                return embs[0]
    except Exception:
        pass

    r = requests.post(
        f"{OLLAMA_URL}/api/embeddings",
        json={"model": EMBED_MODEL, "prompt": text},
        timeout=120,
    )
    r.raise_for_status()
    return r.json()["embedding"]


def search_qdrant(question: str) -> List[Dict[str, Any]]:
    vector = embed_text(question)

    r = requests.post(
        f"{QDRANT_URL}/collections/{COLLECTION_NAME}/points/search",
        json={
            "vector": vector,
            "limit": TOP_K,
            "with_payload": True,
            "with_vector": False,
        },
        timeout=120,
    )

    if r.status_code >= 400:
        raise RuntimeError(f"Qdrant error: {r.status_code} {r.text}")

    return r.json().get("result", [])




def direct_answer_if_possible(question: str, results: List[Dict[str, Any]]):
    """
    Deterministic answer for known clear legal amendment facts.
    Prevents LLM hallucination for exact amendment questions.
    """
    q = (question or "").lower()
    q_bn = question or ""

    is_1993_amendment = (
        "1993" in q
        or "১৯৯৩" in q_bn
    ) and (
        "amendment" in q
        or "সংশোধন" in q_bn
        or "পরিবর্তন" in q_bn
    ) and (
        "acquisition" in q
        or "অধিগ্রহণ" in q_bn
    )

    if not is_1993_amendment:
        return None

    for item in results:
        payload = item.get("payload") or {}
        text = payload.get("text") or ""
        text_low = text.lower()

        if "twenty per centum" in text_low and "fifty per centum" in text_low:
            law_name = payload.get("law_name") or "The Acquisition and Requisition of Immovable Property (Amendment) Ordinance, 1993"
            page = payload.get("page") or ""
            section = payload.get("section") or ""

            return (
                "১৯৯৩ সালের Amendment Ordinance অনুযায়ী ১৯৮২ সালের "
                "Acquisition and Requisition of Immovable Property Ordinance-এর "
                "section 8(2)-এ “twenty per centum” শব্দগুলোর পরিবর্তে "
                "“fifty per centum” বসানো হয়েছে।\n\n"
                f"Source:\n"
                f"- Law: {law_name}\n"
                f"- Page: {page}\n"
                f"- Section: {section}\n"
                f"- Status: {payload.get('status') or 'Unknown'}"
            )

    return None


def build_context(results: List[Dict[str, Any]]) -> str:
    blocks = []

    for i, item in enumerate(results, start=1):
        p = item.get("payload") or {}
        text = (p.get("text") or "").strip()

        if len(text) > 1600:
            text = text[:1600] + "..."

        blocks.append(
            f"""[Source {i}]
Score: {item.get("score")}
Law name: {p.get("law_name", "")}
Source file: {p.get("source_file", "")}
Page: {p.get("page", "")}
Section: {p.get("section", "")}
Status: {p.get("status", "")}

Text:
{text}
"""
        )

    return "\n\n".join(blocks)


def generate_answer(question: str, results: List[Dict[str, Any]]) -> str:
    context = build_context(results)

    prompt = f"""
You are a Bangladesh land-law RAG assistant.

Rules:
1. Use ONLY the retrieved context below.
2. Do NOT use outside knowledge, news, websites, articles, FSSAI, Food Times, or any unrelated source.
3. If the retrieved context does not contain the answer, say exactly: "এই তথ্য প্রদত্ত ডকুমেন্টে পাওয়া যায়নি।"
4. Always mention source law name, page number, section if available, and status if available.
5. If status is Repealed, clearly mention that the source law is repealed.
6. Do not give legal advice. Give document-based information only.
7. Answer in Bangla unless the question is in English.

Question:
{question}

Retrieved context:
{context}

Final answer:
""".strip()

    r = requests.post(
        f"{OLLAMA_URL}/api/generate",
        json={
            "model": LLM_MODEL,
            "prompt": prompt,
            "stream": False,
            "options": {
                "temperature": 0.1,
                "num_ctx": 8192,
            },
        },
        timeout=300,
    )

    if r.status_code >= 400:
        raise RuntimeError(f"Ollama LLM error: {r.status_code} {r.text}")

    return (r.json().get("response") or "").strip()


@login_required(login_url="/login/")
def land_law_page(request):
    if not land_has_access(request.user):
        return render(
            request,
            "land_law/forbidden.html",
            {"required_group": LAND_GROUP_NAME},
            status=403,
        )

    return render(
        request,
        "land_law/page.html",
        {
            "collection_name": COLLECTION_NAME,
            "qdrant_url": QDRANT_URL,
            "ollama_url": OLLAMA_URL,
            "embed_model": EMBED_MODEL,
            "llm_model": LLM_MODEL,
        },
    )


@login_required(login_url="/login/")
@require_POST
def land_law_ask(request):
    if not land_has_access(request.user):
        return json_error(f"Permission denied. Required group: {LAND_GROUP_NAME}", status=403)

    try:
        data = json.loads(request.body.decode("utf-8"))
    except Exception:
        return json_error("Invalid JSON body.", status=400)

    question = (data.get("question") or "").strip()
    if not question:
        return json_error("Question is required.", status=400)

    try:
        results = search_qdrant(question)

        direct_answer = direct_answer_if_possible(question, results)

        llm_error = None
        try:
            answer = direct_answer or generate_answer(question, results)
        except Exception as e:
            llm_error = str(e)
            answer = (
                "Qdrant retrieval সফল হয়েছে, কিন্তু LLM answer generation failed.\n\n"
                "নিচের Sources অংশে retrieved document chunks দেখুন।\n\n"
                f"LLM error: {llm_error}"
            )

        sources = []
        for item in results:
            p = item.get("payload") or {}
            sources.append(
                {
                    "score": item.get("score"),
                    "law_name": p.get("law_name"),
                    "source_file": p.get("source_file"),
                    "page": p.get("page"),
                    "section": p.get("section"),
                    "status": p.get("status"),
                    "text_preview": (p.get("text") or "")[:700],
                }
            )

        return JsonResponse(
            {
                "ok": True,
                "question": question,
                "answer": answer,
                "sources": sources,
                "llm_error": llm_error,
            },
            json_dumps_params={"ensure_ascii": False},
        )

    except Exception as e:
        return json_error(str(e), status=500)
