# Copy to a private file outside version control; supply real secrets and hosts.
DJANGO_SETTINGS_MODULE=buro_first.settings_production
DJANGO_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=192.168.1.144
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.1.144:31135
# SQLite and the atomic cache are stored on the Kubernetes PVC.
DJANGO_DATA_DIR=/data
# Preserve the project's chosen model; fill only if not managed in System Settings.
# OLLAMA_URL=http://your-ollama-host:11434
# OLLAMA_MODEL=your-existing-project-model
# Complete guided setup at /agentic/setup/ to enable this.
MCP_GATEWAY_ENABLED=false
MCP_GATEWAY_URL=http://192.168.1.99:30444/mcp
MCP_TIMEOUT=30
MCP_REQUEST_TIMEOUT=90
GUNICORN_TIMEOUT=120

# For a new SQLite database with no administrator, uncomment and fill these.
# The release script gives these only to the one-time migration Job.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
