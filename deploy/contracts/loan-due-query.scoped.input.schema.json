{
  "type": "object",
  "properties": {
    "branch_code": {
      "type": "string"
    },
    "zone_code": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "employee_code": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "disbursed_from": {
      "type": "string",
      "format": "date"
    },
    "disbursed_to": {
      "type": "string",
      "format": "date"
    },
    "level": {
      "type": "string",
      "enum": [
        "LOAN",
        "MEMBER",
        "BRANCH",
        "ZONE",
        "AREA",
        "DIVISION",
        "PRODUCT",
        "EMPLOYEE"
      ],
      "default": "LOAN"
    },
    "sort_by": {
      "type": "string",
      "enum": [
        "DUEAMOUNT",
        "OUTSTANDINGP",
        "OUTSTANDING_PI",
        "DUE_DAYS",
        "LOAN_COUNT"
      ],
      "default": "DUEAMOUNT"
    },
    "sort_order": {
      "type": "string",
      "enum": [
        "ASC",
        "DESC"
      ],
      "default": "DESC"
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 10
    },
    "min_due": {
      "type": "number",
      "minimum": 0,
      "default": 0.01
    },
    "min_days": {
      "type": "number",
      "minimum": 0
    },
    "loan_access_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 400000,
      "description": "Reserved server-issued signed loan authorization. The backend must verify this token before reading financial data. Never ask the user or model to supply it."
    }
  },
  "required": [
    "report_date",
    "loan_access_token"
  ],
  "additionalProperties": false
}
