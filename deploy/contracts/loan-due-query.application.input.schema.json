{
  "type": "object",
  "properties": {
    "branch_code": {
      "type": "string"
    },
    "zone_code": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "employee_code": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "disbursed_from": {
      "type": "string",
      "format": "date"
    },
    "disbursed_to": {
      "type": "string",
      "format": "date"
    },
    "level": {
      "type": "string",
      "enum": [
        "LOAN",
        "MEMBER",
        "BRANCH",
        "ZONE",
        "AREA",
        "DIVISION",
        "PRODUCT",
        "EMPLOYEE"
      ],
      "default": "LOAN"
    },
    "sort_by": {
      "type": "string",
      "enum": [
        "DUEAMOUNT",
        "OUTSTANDINGP",
        "OUTSTANDING_PI",
        "DUE_DAYS",
        "LOAN_COUNT"
      ],
      "default": "DUEAMOUNT"
    },
    "sort_order": {
      "type": "string",
      "enum": [
        "ASC",
        "DESC"
      ],
      "default": "DESC"
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 10
    },
    "min_due": {
      "type": "number",
      "minimum": 0,
      "default": 0.01
    },
    "min_days": {
      "type": "number",
      "minimum": 0
    },
    "app_branch_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
      },
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "description": "Reserved application-supplied branch filter. Django derives this from the authenticated user policy; never ask the user or model to provide it."
    }
  },
  "required": [
    "report_date",
    "app_branch_codes"
  ],
  "additionalProperties": false
}
