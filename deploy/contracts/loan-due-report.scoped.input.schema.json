{
  "type": "object",
  "properties": {
    "branchCode": {
      "type": "string"
    },
    "reportDate": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "report",
        "rank_overdue_members"
      ],
      "default": "report"
    },
    "zoneCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "zoneName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "loan_access_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 400000,
      "description": "Reserved server-issued signed loan authorization. The backend must verify this token before reading financial data. Never ask the user or model to supply it."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "rank_overdue_members"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "reportDate",
          "limit"
        ],
        "properties": {
          "reportDate": {
            "format": "date"
          }
        },
        "oneOf": [
          {
            "required": [
              "zoneCode"
            ],
            "not": {
              "required": [
                "zoneName"
              ]
            }
          },
          {
            "required": [
              "zoneName"
            ],
            "not": {
              "required": [
                "zoneCode"
              ]
            }
          }
        ],
        "not": {
          "required": [
            "branchCode"
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "zoneCode"
              ]
            },
            {
              "required": [
                "zoneName"
              ]
            },
            {
              "required": [
                "limit"
              ]
            }
          ]
        },
        "required": [
          "branchCode",
          "reportDate"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "required": [
    "loan_access_token"
  ]
}
